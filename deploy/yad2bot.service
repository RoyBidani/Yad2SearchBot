[Unit]
Description=Yad2 apartment notifier (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=yad2bot
WorkingDirectory=/opt/yad2bot
EnvironmentFile=/etc/yad2bot.env
Environment=YAD2BOT_STATE=/var/lib/yad2bot/sent_posts.json PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers PYTHONUNBUFFERED=1
StateDirectory=yad2bot
ExecStart=/opt/yad2bot/venv/bin/python main.py
TimeoutStartSec=900
